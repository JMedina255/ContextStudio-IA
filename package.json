{
  "name": "contextstudio-ia",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Plataforma generadora de proyectos de contexto empresarial para herramientas de IA",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspace=@contextstudio/core",
    "build": "npm run build --workspace=@contextstudio/core",
    "test": "npm run test --workspace=@contextstudio/core",
    "test:coverage": "npm run test:coverage --workspace=@contextstudio/core",
    "demo": "tsx scripts/demo.ts",
    "generate:types": "npm run generate:types --workspace=@contextstudio/core",
    "generate:templates": "npm run generate:templates --workspace=@contextstudio/core"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "@vitest/coverage-v8": "^2.1.3"
  }
}
